# Neon Postgres (never commit the real password)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Public origin used in the constitution, agents.json, sitemap, etc.
ORIGIN="http://localhost:3000"
NEXT_PUBLIC_ORIGIN="http://localhost:3000"

# On Vercel, set DATABASE_URL to the same Neon string.
# ORIGIN can be omitted; the app will use https://$VERCEL_URL.
